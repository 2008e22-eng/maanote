{
  "name": "MaaNote",
  "short_name": "MaaNote",
  "description": "非公式ファン向けイベント・遠征管理アプリ MaaNote。イベント、予定、TODO、旅程などを端末に保存し、初回読込後は主要機能をオフラインでも利用できます。",
  "id": "./",
  "start_url": "./",
  "scope": "./",
  "display": "standalone",
  "background_color": "#F5F8F7",
